# 复制为 .env 后按本机修改；不要提交 .env。

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Pydantic list 使用 JSON 格式。内网演示可保留 *；公网部署必须收窄。
CORS_ORIGINS=["*"]

# ---- Redis / Celery（异步 submit 接口需要） ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- YOLO ----
LABGUARDIAN_MODEL_ROOT=models
# 未显式配置时，代码会依次查找 models/ 与仓库内 train_demo/ 的候选权重。
# YOLO_MODEL_PATH=models/component/best.pt
# PIN_MODEL_PATH=models/pin/best.pt
YOLO_CONF_THRESHOLD=0.2
YOLO_IOU_THRESHOLD=0.5
YOLO_IMGSZ=640
PIPELINE_HIGH_RES_IMGSZ=960
YOLO_DEVICE=cpu
PIN_MODEL_DEVICE=cpu

# ---- Breadboard / mapping ----
BREADBOARD_ROWS=63
BREADBOARD_COLS_PER_SIDE=5
ROI_PADDING=30
PIN_CANDIDATE_K=5

# ---- Agent（默认 template 可离线复现） ----
AGENT_LLM_PROVIDER=template
REACT_MAX_ITERATIONS=1
# AGENT_LLM_PROVIDER=ollama
# AGENT_LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# AGENT_LLM_OLLAMA_MODEL=gemma3:4b
# AGENT_LLM_OLLAMA_TIMEOUT_S=120

# ---- 可选外部 LLM；不要在示例文件中填写真实密钥 ----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- 可选 OpenVINO datasheet embedding ----
DATASHEET_EMBEDDING_BACKEND=null
# DATASHEET_EMBEDDING_MODEL_DIR=models/bge-small-zh-v1.5-int8-ov
# DATASHEET_EMBEDDING_DEVICE=CPU

# ---- 可选 VLM ----
VLM_PROVIDER=template
VLM_TIMEOUT_S=30
# VLM_PROVIDER=openvino_genai
# VLM_OPENVINO_MODEL_DIR=models/Qwen2.5-VL-3B-Instruct-ov-int4
# VLM_OPENVINO_DEVICE=CPU
