# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---- YOLO ----
LABGUARDIAN_MODEL_ROOT=models
# 显式路径优先；未配置时会�?LABGUARDIAN_MODEL_ROOT 下的 component/pin 约定查找，再回退�?train_demo�?
# YOLO_MODEL_PATH=models/component/best.pt
# PIN_MODEL_PATH=models/pin/best.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IMGSZ=960
PIPELINE_HIGH_RES_IMGSZ=960
YOLO_DEVICE=cpu
PIN_MODEL_DEVICE=cpu

# ---- 面包�?----
BREADBOARD_ROWS=63
BREADBOARD_COLS_PER_SIDE=5

# ---- Distill Teacher LLM ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Optional future judge step
# OPENAI_API_KEY=

# ---- 本地轻量 VLM（可选，板端部署�?---
# 默认 template，不调用模型；板端模型服务就绪后可改�?openai_compatible�?
VLM_PROVIDER=template
# VLM_PROVIDER=openai_compatible
# VLM_BASE_URL=http://127.0.0.1:8001/v1
# VLM_MODEL=local-vlm
VLM_TIMEOUT_S=30

# OpenVINO GenAI 本地推理（Qwen2.5-VL-3B-Instruct OpenVINO INT4�?
# VLM_PROVIDER=openvino_genai
# VLM_OPENVINO_MODEL_DIR=/models/Qwen2.5-VL-3B-Instruct-ov-int4
# VLM_OPENVINO_DEVICE=CPU
# VLM_OPENVINO_CACHE_DIR=artifacts/openvino_cache
# VLM_MAX_NEW_TOKENS=256

# ---- Agent LLM（诊�?ReAct�?---
# 本地 Ollama（推荐）: 已接�?qwen3:4b
# AGENT_LLM_PROVIDER=ollama
# AGENT_LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# AGENT_LLM_OLLAMA_MODEL=qwen3:4b
# AGENT_LLM_OLLAMA_TIMEOUT_S=120

# 默认 template（不调用大模型）
AGENT_LLM_PROVIDER=template
REACT_MAX_ITERATIONS=1
