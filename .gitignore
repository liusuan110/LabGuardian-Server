# OS / editor
.DS_Store
*.swp

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
.venv-export/
venv/

# Local environment
.env
!.env.example

# Generated demo / experiment outputs
demo_output/
detect_results/
proposal_heatmaps/
artifacts/archive/*.txt
test_output/
test_output_multi/
outputs/

# Coverage / packaging
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Phase 3 — local model weights (OpenVINO IR). Converted offline via
# `optimum-cli export openvino ...`; shipped via the device image, not git.
models/

# Generated chunk embedding caches. Re-built on the dev machine after every
# datasheet ingest or model change with scripts/build_datasheet_embeddings.py.
# Keep them out of git so we don't bloat the repo with binary blobs.
knowledge/datasheets/embeddings/*.npz

# Datasets — large files kept locally, not tracked in git
datasets/*
!datasets/distill/
datasets/distill/*
!datasets/distill/dataset_info.json
!datasets/distill/train_sft_alpaca.jsonl

# Checkpoints — model weights kept locally, not tracked in git
checkpoints/
