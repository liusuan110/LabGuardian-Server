      "ref_id": "VT1",
      "type": "Transistor",
      "pins": [
        { "pin": "base", "net": "UI1" },
        { "pin": "collector", "net": "UO1" },
        { "pin": "emitter", "net": "E1" }
      ]
    },
    {
      "ref_id": "VT2",
      "type": "Transistor",
      "pins": [
        { "pin": "base", "net": "UI2" },
        { "pin": "collector", "net": "UO2" },
        { "pin": "emitter", "net": "E2" }
      ]
    },
    {
      "ref_id": "VT3",
      "type": "Transistor",
      "pins": [
        { "pin": "base", "net": "VB3" },
        { "pin": "collector", "net": "TAIL" },
        { "pin": "emitter", "net": "VE3" }
      ]
    },
    {
      "ref_id": "Rc1",
      "type": "Resistor",
      "pins": [
        { "pin": "pin1", "net": "VCC" },
        { "pin": "pin2", "net": "UO1" }
      ]
    },
    {
      "ref_id": "Rc2",
      "type": "Resistor",
      "pins": [
        { "pin": "pin1", "net": "VCC" },
        { "pin": "pin2", "net": "UO2" }
      ]
    },
