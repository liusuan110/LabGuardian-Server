{
  "schema_version": "circuit_v1",
  "circuit_id": "common_emitter_amplifier",
  "name": "NPN 共射极放大电路（分压偏置）",
  "category": "三极管放大电路",
  "subcategory": "共射极",
  "keywords": [
    "共射放大", "共射极", "common emitter", "CE amplifier",
    "NPN", "三极管放大", "分压偏置", "电压放大",
    "2N3904", "偏置电路", "A类放大", "class A"
  ],
  "summary": "经典 NPN 共射极放大电路，采用 R1/R2 电阻分压为基极提供直流偏置，Rc 为集电极负载电阻将电流变化转化为电压输出，Re 为发射极负反馈电阻稳定静态工作点，C1/C2 为输入输出耦合电容实现隔直通交。输入信号经 C1 耦合到基极，放大后信号从集电极经 C2 输出。",
  "components": [
    {
      "ref": "R1",
      "type": "电阻",
      "value": "100kΩ",
      "role": "上偏置电阻",
      "purpose": "与 R2 分压为基极提供直流偏置电压，Vb≈VCC×R2/(R1+R2)"
    },
    {
      "ref": "R2",
      "type": "电阻",
      "value": "20kΩ",
      "role": "下偏置电阻",
      "purpose": "与 R1 分压，将基极电压稳定在约 VCC/6"
    },
    {
      "ref": "Rc",
      "type": "电阻",
      "value": "5kΩ",
      "role": "集电极负载电阻",
      "purpose": "将集电极电流 Ic 的变化转换为集电极电压 Vc 的变化，决定电压增益"
    },
    {
      "ref": "Re",
      "type": "电阻",
      "value": "1kΩ",
      "role": "发射极负反馈电阻",
      "purpose": "引入直流负反馈稳定静态工作点，抑制温度漂移；未旁路时降低交流增益提高线性度"
    },
    {
      "ref": "C1",
      "type": "电容",
      "value": "10μF",
      "role": "输入耦合电容",
      "purpose": "隔直通交，将交流输入信号耦合到基极，同时隔离信号源的直流分量避免影响偏置"
    },
    {
      "ref": "C2",
      "type": "电容",
      "value": "10μF",
      "role": "输出耦合电容",
      "purpose": "隔直通交，从集电极提取放大后的交流信号，隔离集电极直流电压"
    },
    {
      "ref": "Q1",
      "type": "NPN三极管",
      "value": "2N3904",
      "role": "放大元件",
      "purpose": "工作在放大区，利用基极小电流控制集电极大电流，实现电压/电流放大"
    }
  ],
  "connections": [
    {"from": "VCC", "to": "R1"},
    {"from": "VCC", "to": "Rc"},
    {"from": "R1", "to": "Q1.B"},
    {"from": "R2", "to": "Q1.B"},
    {"from": "R2", "to": "GND"},
    {"from": "Rc", "to": "Q1.C"},
    {"from": "Q1.C", "to": "C2"},
    {"from": "Q1.E", "to": "Re"},
    {"from": "Re", "to": "GND"},
    {"from": "Input", "to": "C1"},
    {"from": "C1", "to": "Q1.B"},
    {"from": "C2", "to": "Output"}
  ],
  "analysis": {
    "voltage_gain": "Av≈-Rc/Re=-5（无旁路电容时）；加旁路电容 Ce 并联 Re 时 Av≈-Rc/re≈-200",
    "input_impedance": "Zin≈R1‖R2‖(β×Re)≈15kΩ（β=100 时）",
    "output_impedance": "Zo≈Rc=5kΩ",
    "quiescent_base_voltage": "Vb≈VCC×R2/(R1+R2)",
    "quiescent_emitter_voltage": "Ve≈Vb-0.7V",
    "quiescent_collector_current": "Ic≈Ie=Ve/Re≈1mA",
    "quiescent_collector_voltage": "Vce≈VCC-Ic×(Rc+Re)",
    "phase": "输出与输入反相（180°相移）",
    "bandwidth": "低频截止由 C1/C2 决定，高频截止由 Q1 寄生电容和米勒效应决定"
  },
  "common_faults": [
    {"fault": "R1 开路", "consequence": "基极电压降到 0V，Q1 截止，Vc=VCC，无输出信号"},
    {"fault": "R2 开路", "consequence": "基极电压升至 VCC，Q1 饱和，Vc≈Ve，输出严重失真"},
    {"fault": "Re 短路", "consequence": "增益变大但失去直流负反馈，静态工作点随温度漂移，易饱和失真"},
    {"fault": "Rc 短路", "consequence": "Vc=VCC 不变，输出电压恒为 VCC，无放大作用"},
    {"fault": "C1 开路", "consequence": "输入信号无法到达基极，无输出"},
    {"fault": "C2 开路", "consequence": "放大信号无法传递到负载，输出端无信号"},
    {"fault": "C1 短路", "consequence": "信号源直流分量影响基极偏置，工作点偏移，可能截止或饱和"}
  ],
  "teaching_points": [
    "分压偏置如何为三极管设定静态工作点 Q",
    "直流负载线与交流负载线的区别",
    "Re 直流负反馈稳定 Q 点的原理",
    "耦合电容 C1/C2 的隔直通交作用",
    "输入耦合电容与基极输入阻抗形成高通滤波器",
    "为什么输出与输入反相（180°相移）",
    "如何选择 R1/R2 使 Q 点位于负载线中点以获得最大不失真输出摆幅"
  ],
